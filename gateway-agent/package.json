{
  "name": "dms-integration-gateway-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/index.js",
    "config:check": "node src/index.js --check-config",
    "source:check": "node src/index.js --check-source",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/install-service.ps1",
    "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/service.ps1 -Action status",
    "service:start": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/service.ps1 -Action start",
    "service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/service.ps1 -Action stop",
    "service:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/service.ps1 -Action restart",
    "service:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/service.ps1 -Action logs",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/uninstall-service.ps1",
    "check": "node --check src/index.js && node --check src/gateway-client.js && node --check src/adapters/adapter-factory.js && node --check src/adapters/simulated.adapter.js && node --check src/adapters/milestone.adapter.js"
  }
}
