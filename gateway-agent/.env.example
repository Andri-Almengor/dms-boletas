DMS_GATEWAY_URL=https://su-servicio.onrender.com
DMS_GATEWAY_ID=gateway-reemplace-este-id
DMS_GATEWAY_TOKEN=reemplace-el-token-mostrado-una-sola-vez
DMS_GATEWAY_NAME=Sede de pruebas

# Adaptador activo: simulated, network o milestone
DMS_GATEWAY_ADAPTER=simulated
DMS_GATEWAY_HEARTBEAT_MS=30000
DMS_GATEWAY_POLL_MS=10000

# Para NETWORK_DISCOVERY el inventario se vuelve a explorar cada 10 minutos por defecto.
# Ponga 0 para desactivar la sincronización periódica o un valor >= 60000.
DMS_GATEWAY_INVENTORY_SYNC_MS=

# Simulador
DMS_SIMULATED_DEVICE_COUNT=3

# Descubrimiento directo de cámaras en la red local - DMS_GATEWAY_ADAPTER=network
# Si queda vacío, el agente detecta automáticamente las interfaces IPv4 privadas del equipo.
# Por seguridad solo se aceptan subredes privadas /24 a /30. Para redes mayores enumere varios /24.
DMS_NETWORK_CIDRS=
DMS_NETWORK_SCAN_PORTS=80,443,554
DMS_NETWORK_PROBE_TIMEOUT_MS=600
DMS_NETWORK_ONVIF_TIMEOUT_MS=1500
DMS_NETWORK_SCAN_CONCURRENCY=48
DMS_NETWORK_MAX_HOSTS=1024

# Milestone XProtect - solo se requieren cuando DMS_GATEWAY_ADAPTER=milestone
DMS_MILESTONE_URL=https://milestone-servidor.local
DMS_MILESTONE_USERNAME=
DMS_MILESTONE_PASSWORD=
DMS_MILESTONE_TIMEOUT_MS=15000
DMS_MILESTONE_PAGE_SIZE=100
DMS_MILESTONE_MAX_DEVICES=2500

# Producción: mantener ambos en false y usar un certificado confiable o DMS_MILESTONE_CA_FILE.
DMS_MILESTONE_ALLOW_HTTP=false
DMS_MILESTONE_ALLOW_INSECURE_TLS=false
DMS_MILESTONE_CA_FILE=
