{
  "name": "dms-boletas-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "node --expose-gc --import ./src/services/gemini-model-router.bootstrap.js --import ./src/services/maintenance-finalization-router.bootstrap.js --watch src/server.js",
    "start": "node --expose-gc --import ./src/services/gemini-model-router.bootstrap.js --import ./src/services/maintenance-finalization-router.bootstrap.js src/server.js",
    "check": "node --check src/services/gemini-model-router.bootstrap.js && node --check src/services/maintenance-finalization-router.bootstrap.js && node --check src/services/sheets-memory-guard.service.js && node --check src/server.js && node --test test/*.test.js test/storage-boundary.mjs test/xlsx-migration.mjs",
    "test:db": "node --test test/postgres-integration.mjs",
    "test:xlsx-import-idempotence": "node --test test/xlsx-import-idempotence.mjs",
    "db:migrate": "node src/scripts/db-migrate.js",
    "db:status": "node src/scripts/db-status.js",
    "db:stage2:verify": "node src/scripts/db-stage2-verify.js",
    "db:stage3:analyze": "node src/scripts/db-stage3-analyze.js",
    "db:stage3:preflight": "node src/scripts/db-stage3-preflight.js",
    "db:stage3:verify": "node src/scripts/db-stage3-verify.js",
    "db:stage3:final-audit": "node src/scripts/db-stage3-final-audit.js",
    "db:import:xlsx": "node src/scripts/db-import-xlsx.js",
    "db:verify": "node src/scripts/db-verify.js",
    "db:backup:verify": "node src/scripts/db-backup-verify.js",
    "db:backup:restore": "node src/scripts/db-backup-restore.js",
    "db:benchmark": "node src/scripts/db-benchmark.js",
    "db:stage5:verify": "node src/scripts/db-stage5-verify.js",
    "db:test:reset": "node src/scripts/db-test-reset.js",
    "test:db:safety": "node --test test/test-database-safety.mjs"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "nodemailer": "9.1.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "exceljs": "4.4.0"
  }
}
