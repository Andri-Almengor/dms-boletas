NODE_ENV=production
PORT=10000
GOOGLE_SHEET_ID=11u44CTxL2KWqwezF_p3Kkc4OoB71BKsQwIh-NLRFgm4
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SESSION_HOURS=12
FRONTEND_ORIGIN=https://dms-boletas.onrender.com
APP_PUBLIC_URL=https://dms-boletas.onrender.com

# Recuperación de lecturas transitorias de Google Sheets.
# Los valores predeterminados ya funcionan sin configurarlos en Render.
SHEETS_TRANSIENT_RETRIES=2
SHEETS_TRANSIENT_BACKOFF_MS=800
SHEETS_TRANSIENT_MAX_BACKOFF_MS=8000
SHEETS_GLOBAL_READ_STALE_MS=300000

# Estado automático de mantenimientos al Chat específico de cada cliente.
# De lunes a viernes; por defecto a las 07:00 y 17:00 en Costa Rica.
# También se avisa al crear un mantenimiento o cambiar sus cantidades planificadas.
MAINTENANCE_PROGRESS_CHAT_ENABLED=true
MAINTENANCE_PROGRESS_CHAT_TIMEZONE=America/Costa_Rica
MAINTENANCE_PROGRESS_CHAT_HOURS=7,17
MAINTENANCE_PROGRESS_CHAT_TICK_MS=30000

# Genere una llave de 32 bytes con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guárdela únicamente como secreto del servidor. No la cambie después de guardar credenciales sin realizar una migración.
PASSWORD_VAULT_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DMS Boletas <no-reply@solutionsdms.com>"
GOOGLE_CHAT_WEBHOOK=
