NODE_ENV=production
PORT=10000

# PostgreSQL operacional. En Render, el Web Service debe usar la INTERNAL DATABASE URL.
# No guarde URLs reales ni credenciales en Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dms_boletas
# Exclusiva para pruebas destructivas/integración. Nunca apunte al DATABASE_URL de producción.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dms_boletas_test
PG_POOL_MAX=3
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=8000
PG_STATEMENT_TIMEOUT_MS=60000
PG_SLOW_QUERY_MS=1000

# Google se conserva para Drive y para spreadsheets/documentos generados como salida.
# Google Sheets NO se utiliza como base de datos operacional.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

SESSION_HOURS=12
FRONTEND_ORIGIN=https://dms-boletas.onrender.com
APP_PUBLIC_URL=https://dms-boletas.onrender.com

# Sincronización incremental PostgreSQL ↔ IndexedDB.
INCREMENTAL_SYNC_ENABLED=true
SYNC_SCHEMA_VERSION=2
SYNC_DELTA_MAX_EVENTS=250
SYNC_DELTA_SNAPSHOT_THRESHOLD=5000
SYNC_BACKGROUND_INTERVAL_MS=60000
SYNC_INTEGRITY_CHECK_MS=900000

# Estado automático de mantenimientos al Chat específico de cada cliente.
MAINTENANCE_PROGRESS_CHAT_ENABLED=true
MAINTENANCE_PROGRESS_CHAT_TIMEZONE=America/Costa_Rica
MAINTENANCE_PROGRESS_CHAT_HOURS=7,17
MAINTENANCE_PROGRESS_CHAT_TICK_MS=30000

# Genere una llave de 32 bytes con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guárdela únicamente como secreto del servidor. No la cambie después de guardar credenciales sin realizar una migración.
PASSWORD_VAULT_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DMS Boletas <no-reply@solutionsdms.com>"
GOOGLE_CHAT_WEBHOOK=

# Agente IA DMS (solo backend; nunca exponga GEMINI_API_KEY al frontend).
# Los nombres de modelo son configuración de despliegue. GEMINI_MODEL se conserva solo como alias compatible.
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_LAST_RESORT_MODEL=
GEMINI_MODEL=

# AI_AGENT_ENABLED es el nombre preferido; AI_CHAT_ENABLED se conserva como alias compatible.
AI_AGENT_ENABLED=true
AI_CHAT_ENABLED=true
AI_WEB_SEARCH_ENABLED=false
AI_MODEL_FALLBACK_ENABLED=true
AI_MAX_MODEL_FALLBACKS=2

AI_GEMINI_TIMEOUT_MS=60000
AI_TOOL_TIMEOUT_MS=15000
AI_AGENT_TOTAL_TIMEOUT_MS=120000
AI_MAX_TOOL_ROUNDS=8
AI_MAX_PARALLEL_TOOLS=3
AI_MAX_OUTPUT_TOKENS=8192

AI_MAX_TOOL_RESULT_ROWS=50
AI_MAX_TOOL_RESULT_BYTES=48000
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_MESSAGE_CHARS=5000
AI_RATE_LIMIT_PER_MINUTE=12

# Escrituras del agente: mantener deshabilitadas hasta aplicar migraciones y validar PREPARE/COMMIT.
AI_WRITE_ENABLED=false
AI_MAINTENANCE_WRITE_ENABLED=false
AI_MAX_DEVICE_CREATE_BATCH=100
AI_MAX_EVIDENCE_UPLOAD_BATCH=50
AI_PENDING_OPERATION_TTL_MINUTES=15

# Knowledge documental. Los binarios siguen privados en Drive; PostgreSQL guarda metadata y chunks.
AI_KNOWLEDGE_DOCUMENTS_ENABLED=true
AI_KNOWLEDGE_MAX_CHUNKS=8
AI_KNOWLEDGE_MAX_CHUNK_BYTES=12000
# Recuperación serial de documentos cuyo proceso fue interrumpido por restart/sleep.
AI_KNOWLEDGE_RECOVERY_BATCH=2
AI_KNOWLEDGE_RECOVERY_INTERVAL_MS=300000
