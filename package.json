{
  "name": "dms-boletas",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm --prefix backend start",
    "install:all": "npm install && npm --prefix backend install",
    "check:backend": "npm --prefix backend run check",
    "test:characterization": "node --test tests/characterization/all.test.mjs",
    "baseline": "node scripts/collect-baseline.mjs",
    "report:final": "node scripts/final-validation.mjs",
    "audit:security": "npm audit --omit=dev --audit-level=high && npm --prefix backend audit --omit=dev --audit-level=high",
    "verify:stage0": "npm run test:characterization && npm run check:backend && npm run build && npm run baseline",
    "verify:final": "npm run verify:stage0 && npm run audit:security && npm run report:final"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.1"
  }
}
